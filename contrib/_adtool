#compdef adtool
# Zsh completion for adtool. Maintainer: Carlos Andrade <carlos@perezandrade.com>
# Generated by 'adtool completion zsh'; do not edit, change adtool instead.
# Options come from 'adtool __flags' and names from 'adtool __complete'.

_adtool() {
  local bin=${words[1]} cmd line opt val desc flag="" value=""
  local -a items names
  local -A kinds
  local kind

  if (( CURRENT == 2 )); then
    for line in ${(f)"$(command $bin __flags top 2>/dev/null)"}; do
      opt=${line%%|*}; desc=${line##*|}
      items+=("${opt}:${desc}")
    done
    _describe -t commands command items
    return
  fi

  cmd=${words[2]}
  case $cmd in
    u) cmd=user ;; g) cmd=group ;; c|pc) cmd=computer ;; pw) cmd=password ;;
  esac
  case $cmd in
    password|completion)
      if (( CURRENT == 3 )); then
        for line in ${(f)"$(command $bin __flags $cmd 2>/dev/null)"}; do
          items+=("${line%%|*}:${line##*|}")
        done
        _describe -t arguments argument items
      fi
      return ;;
    user|group|computer) ;;
    *) return ;;
  esac

  for line in ${(f)"$(command $bin __flags $cmd 2>/dev/null)"}; do
    opt=${line%%|*}; val=${${line#*|}%%|*}; desc=${line##*|}
    kinds[$opt]=$val
    items+=("${opt}:${desc}")
  done

  # --count=<TAB> and -c=<TAB>
  if [[ $PREFIX == -*=* ]]; then
    flag=${PREFIX%%=*}; value=${PREFIX#*=}
    if [[ ${kinds[$flag]} == =* ]]; then
      compadd -P "${flag}=" -- ${(s:,:)${kinds[$flag]#=}}
      return
    fi
  fi

  # the value of --dept / --title
  flag=${words[CURRENT-1]}
  case ${kinds[$flag]} in
    @dept|@title)
      kind=depts; [[ ${kinds[$flag]} == @title ]] && kind=titles
      names=("${(@f)$(command $bin __complete $kind ${(Q)PREFIX} 2>/dev/null)}")
      compadd -- ${names:#} ; return ;;
    '#') return ;;
  esac

  if [[ $PREFIX == -* ]]; then
    _describe -t options option items
    return
  fi

  # a name: logins for an account action, otherwise what the command searches
  local action=0 w
  kind=users
  for w in ${words[3,CURRENT-1]}; do
    case $w in -r|--reset|-l|--lock|-u|--unlock) action=1 ;; esac
  done
  case $cmd in group) kind=groups ;; computer) kind=computers ;; esac
  if [[ -z $PREFIX && $action == 0 ]]; then
    _describe -t options option items
  else
    names=("${(@f)$(command $bin __complete $kind ${(Q)PREFIX} 2>/dev/null)}")
    compadd -- ${names:#}
  fi
}

if [[ $funcstack[1] == _adtool ]]; then
  _adtool "$@"
else
  compdef _adtool adtool
fi
